# AlBayan Cairo ERP — muhit o'zgaruvchilari namunasi
# Nusxa oling:  cp .env.example .env
# .env fayli hech qachon repozitoriyaga tushmaydi (.gitignore da yozilgan).
#
# Tekshirish:  npm run check:db     (baza ulanishini sinab ko'radi)

# --- Umumiy ---
APP_NAME="AlBayan Cairo"
PORT=3000
NODE_ENV=production

# ============================================================
#  MA'LUMOTLAR BAZASI
# ============================================================
# Bo'sh qoldirsangiz: DATA_DIR papkasida fayl bazasi ishlatiladi.
#
# ---- ICHKI (Internal) va TASHQI (External) manzil farqi ----
# Render sizga Postgres uchun IKKITA manzil beradi:
#
#   Internal Database URL   →  dpg-xxxxxxxx-a/albayan
#       Nuqtasiz, qisqa nom. Faqat Render ICHIDA ishlaydi.
#       Ilovaning o'zi shuni ishlatsin:
#         • tezroq (bir xil ma'lumotlar markazida),
#         • trafik bepul,
#         • SSL kerak emas.
#       >>> Render'dagi web service uchun SHU manzilni qo'ying. <<<
#
#   External Database URL   →  dpg-xxxxxxxx-a.frankfurt-postgres.render.com/albayan
#       To'liq domen nomi. Internetdan ulanish uchun.
#       Faqat mana bu hollarda kerak:
#         • kompyuteringizdan tekshirish:  npm run check:db
#         • ma'lumot ko'chirish, pgAdmin / DBeaver kabi dasturlar,
#         • sinov (node tests/db-test.js).
#       SSL avtomatik yoqiladi.
#
# Neon ishlatsangiz: neon.tech → Project → Connection string →
# "Pooled connection". Oxirida ?sslmode=require bo'lsin.
# Namuna:
# DATABASE_URL="postgresql://user:parol@ep-xxx-pooler.eu-central-1.aws.neon.tech/albayan?sslmode=require"
#
# Render ichki namunasi (serverda):
# DATABASE_URL="postgresql://albayan:parol@dpg-xxxxxxxx-a/albayan"
#
# Render tashqi namunasi (kompyuterda):
# DATABASE_URL="postgresql://albayan:parol@dpg-xxxxxxxx-a.frankfurt-postgres.render.com/albayan"
DATABASE_URL=""

# Fayl bazasi qayerda saqlansin (Render'da doimiy disk yo'li: /var/data)
DATA_DIR="./data"

# --- Baza ulanishini sozlash (odatda o'zgartirish shart emas) ---
# SSL o'zi to'g'ri tanlanadi. Majburan belgilash kerak bo'lsa:
#   PGSSLMODE=require   → doim SSL bilan
#   PGSSLMODE=disable   → SSL'siz (faqat ichki tarmoq yoki shu kompyuter)
# PGSSLMODE=""
#
# Neon bepul tarifida "compute" soatlari cheklangan. Bo'sh ulanish tez yopilsa,
# Neon uyquga ketadi va soatlar behuda sarflanmaydi.
PG_POOL_MAX=4
PG_IDLE_MS=15000
PG_CONNECT_MS=15000

# --- Zaxira nusxa ---
# Qayerda saqlansin (Render'da doimiy diskda bo'lsin)
BACKUP_DIR="./backups"
# Nechta zaxira saqlansin
BACKUP_KEEP=30
# Zaxira tekshiruvi oralig'i (millisekund). Standart: 6 soat.
# BACKUP_CHECK_MS=21600000

# --- Avtomatik oylik hisoblar ---
# Tekshiruv oralig'i (millisekund). Standart: 6 soat.
# AUTO_INVOICE_CHECK_MS=21600000

# --- Sessiya ---
SESSION_MAX_AGE_DAYS=7

# --- Birinchi direktor hisobi ---
# Faqat baza butunlay bo'sh bo'lganda ishlatiladi.
# Bo'sh qoldirilsa, birinchi parol: 1234 (ilova uni almashtirishni so'raydi).
SEED_DIRECTOR_LOGIN="admin"
SEED_DIRECTOR_PASSWORD=""

# --- Telegram bot ---
# @BotFather dan olingan token. Bo'sh bo'lsa bot ishga tushmaydi.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Navbat bo'sh bo'lsa, bot bazani shuncha vaqtda bir marta tekshiradi (millisekund).
# Yangi xabar yoki administrator tasdig'i bo'lsa — kutmasdan darhol ishlaydi.
# Standart: 10 daqiqa. Kichraytirsangiz baza so'rovlari ko'payadi.
# BOT_IDLE_MS=600000
