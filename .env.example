# Albyana ERP — muhit o'zgaruvchilari namunasi
# Nusxa oling:  cp .env.example .env
# .env fayli hech qachon repozitoriyaga tushmaydi (.gitignore da yozilgan).

# --- Umumiy ---
APP_NAME="Albyana"
PORT=3000
NODE_ENV=production

# --- Ma'lumotlar bazasi ---
# Bo'sh qoldirsangiz: DATA_DIR papkasida fayl bazasi ishlatiladi.
#
# Neon (bepul PostgreSQL) uchun: neon.tech → Project → Connection string →
# "Pooled connection" ni nusxalang. Oxirida ?sslmode=require bo'lishi kerak.
# Namuna:
# DATABASE_URL="postgresql://foydalanuvchi:parol@ep-xxx-pooler.eu-central-1.aws.neon.tech/albyana?sslmode=require"
DATABASE_URL=""

# Fayl bazasi qayerda saqlansin (Render'da doimiy disk yo'li: /var/data)
DATA_DIR="./data"

# --- Baza ulanishini sozlash (odatda o'zgartirish shart emas) ---
# Neon bepul tarifida "compute" soatlari cheklangan. Bo'sh ulanish tez yopilsa,
# Neon uyquga ketadi va soatlar behuda sarflanmaydi.
PG_POOL_MAX=4
PG_IDLE_MS=15000
PG_CONNECT_MS=15000

# --- Zaxira nusxa ---
# Qayerda saqlansin (Render'da doimiy diskda bo'lsin)
BACKUP_DIR="./backups"
# Nechta zaxira saqlansin
BACKUP_KEEP=30
# Zaxira tekshiruvi oralig'i (millisekund). Standart: 6 soat.
# BACKUP_CHECK_MS=21600000

# --- Avtomatik oylik hisoblar ---
# Tekshiruv oralig'i (millisekund). Standart: 6 soat.
# AUTO_INVOICE_CHECK_MS=21600000

# --- Sessiya ---
SESSION_MAX_AGE_DAYS=7

# --- Birinchi direktor hisobi ---
# Faqat baza butunlay bo'sh bo'lganda ishlatiladi.
# Bo'sh qoldirilsa, birinchi parol: 1234 (ilova uni almashtirishni so'raydi).
SEED_DIRECTOR_LOGIN="admin"
SEED_DIRECTOR_PASSWORD=""

# --- Telegram bot ---
# @BotFather dan olingan token. Bo'sh bo'lsa bot ishga tushmaydi.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
