# Albyana ERP — muhit o'zgaruvchilari namunasi
# Nusxa oling:  cp .env.example .env
# .env fayli hech qachon repozitoriyaga qo'shilmaydi.

# --- Umumiy ---
APP_NAME="Albyana"
PORT=3000
NODE_ENV=production

# --- Ma'lumotlar bazasi ---
# Bo'sh qoldirsangiz: data/ papkasida fayl bazasi ishlatiladi (kichik markaz uchun yetarli).
# PostgreSQL uchun: postgresql://foydalanuvchi:parol@host:5432/albyana
DATABASE_URL=""
# Fayl bazasi qayerda saqlansin (Render'da doimiy disk yo'li)
DATA_DIR="./data"

# --- Sessiya ---
SESSION_MAX_AGE_DAYS=7

# --- Birinchi direktor hisobi ---
# Faqat baza bo'sh bo'lganda ishlatiladi. Kuchli parol qo'ying,
# birinchi kirishdan keyin bu qatorlarni bo'shatib qo'ying.
SEED_DIRECTOR_LOGIN="admin"
SEED_DIRECTOR_PASSWORD=""

# --- Telegram bot ---
# @BotFather dan olingan token. Bo'sh bo'lsa bot ishga tushmaydi.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
